{
  "name": "@swoltracker/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/failure-converter.cjs dist/worker/src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx --env-file-if-exists=.env src/worker.ts",
    "dev:start-loop": "tsx --env-file-if-exists=.env src/dev/start-loop.ts",
    "dev:send-missed": "tsx --env-file-if-exists=.env src/dev/send-missed.ts",
    "dev:decide": "tsx --env-file-if-exists=.env src/dev/decide.ts",
    "dev:state": "tsx --env-file-if-exists=.env src/dev/state.ts",
    "dev:stop": "tsx --env-file-if-exists=.env src/dev/stop.ts",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env src/worker.ts"
  },
  "dependencies": {
    "@temporalio/activity": "1.25.0",
    "@temporalio/client": "1.25.0",
    "@temporalio/common": "1.25.0",
    "@temporalio/worker": "1.25.0",
    "@temporalio/workflow": "1.25.0",
    "tsx": "^4.19.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@temporalio/testing": "1.25.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.9"
  }
}
