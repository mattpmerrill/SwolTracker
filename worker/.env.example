# Copy to worker/.env (gitignored) and fill in. Names only here; never commit values.

# Required. Where the worker's activities call. Local `vercel dev` is usually http://localhost:3000.
SWOLTRACKER_API_URL=
# Required. The bearer secret; must equal CHECKIN_WORKER_SECRET on Vercel (or in the .env.local vercel dev reads).
CHECKIN_WORKER_SECRET=

# Local dev server (`temporal server start-dev`): leave these three empty/unset.
# Defaults: localhost:7233 and the "default" namespace.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
# Temporal Cloud only. Setting it turns TLS on and REQUIRES CHECKIN_CODEC_KEY.
TEMPORAL_API_KEY=

# Optional locally, required with TEMPORAL_API_KEY. Base64 of 32 random bytes (openssl rand -base64 32).
# Must equal CHECKIN_CODEC_KEY on Vercel, or the API and the worker cannot read each other's payloads.
CHECKIN_CODEC_KEY=

# Dev scripts (npm run dev:state etc.) take the user id as an argument.
# Optional: where dev:start-loop says the Temporal UI is (default http://localhost:8233).
TEMPORAL_UI_URL=
# `npm start` sets NODE_ENV=production, which switches the dev fast-forward off (see README).
# TEMPORAL_API_KEY switches it off too.
