{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "paths": {
      "@shared/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../src/lib/**/*.js",
    "../src/utils/**/*.js",
    "../src/constants/**/*.js",
    "nativewind-env.d.ts"
  ]
}