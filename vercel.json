{
  "buildCommand": "cd mcp && npm install && npm run build && cd .. && npm test && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/llm.js": {
      "memory": 1024,
      "maxDuration": 300
    },
    "api/mcp.js": {
      "maxDuration": 30
    },
    "api/mcp/context.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
